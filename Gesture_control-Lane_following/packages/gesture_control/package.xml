<?xml version="1.0"?>
<package format="2">
  <name>gesture_control</name>
  <version>0.1.0</version>
  <description>TCP gesture control for Duckietown robot</description>

  <maintainer email="your.email@example.com">Cinzia Tomaselli</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- build dependencies -->
  <build_depend>message_generation</build_depend>
  <build_depend>duckietown_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>opencv-python</build_depend>
  <build_depend>mediapipe</build_depend>


  <!-- runtime dependencies -->
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>message_generation</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3</exec_depend>

  <!-- opzionale, se usi NumPy o altro -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>

  <export>
    <build_type>catkin</build_type>
  </export>

</package>
