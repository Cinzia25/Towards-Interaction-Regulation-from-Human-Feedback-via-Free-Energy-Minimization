<?xml version="1.0"?>
<package format="2">
  <name>fpd_control</name>
  <version>1.0.0</version>
  <description>The package containing the lane controller.</description>

  <maintainer email="paull@mit.edu">Liam Paull</maintainer>
  <author email="jesawadahozefa47@gmail.com">Steven</author>
  <author email="syliu@mit.edu">Shih-Yuan Liu</author>

  <license>GPLv3</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- build dependencies -->
  <build_depend>message_generation</build_depend>
  <build_depend>duckietown_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>

  <!-- runtime dependencies -->
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3</exec_depend>

  <!-- opzionale, se usi NumPy o altro -->
  <!-- <exec_depend>python3-numpy</exec_depend> -->
  <!-- <exec_depend>python3-sklearn</exec_depend> -->

  <export>
    <build_type>catkin</build_type>
  </export>
</package>

