<?xml version="1.0" encoding="utf-8"?>
<launch>
	<arg name="veh"/>
	<arg name="param_file_name" default="default" doc="Specify a param file. ex:megaman"/>
	<arg name="param_file_name_wheels_driver_node" default="default" doc="Specify a param file. ex:megaman"/>
	<arg name="pkg_name" default="fpd_control" doc="name of the package"/>
	<arg name="node_name" default="fpd_lane_controller_node" doc="name of the node"/>

	<!-- start basic args -->
	<include file="$(find duckietown_demos)/launch/master.launch">
	    <!-- Basic arguments -->
		<arg name="veh" value="$(arg veh)"/>
        <arg name="demo_name" value="lane_following"/>
		<arg name="param_file_name" value="default" />
		<arg name="visualization" value="true" />
		<arg name="robot_type" value="duckiebot"/>
        <arg name="robot_configuration" value="DB21J"/>


	    <!-- Finite state machine -->
	    <!-- <arg name="fsm" value="true"/>
	    <arg name="/fsm/logic_gate" value="false"/> -->

		<!-- Camera and anti intagram -->
		<arg name="anti_instagram" value="false" />

		<!-- Deadreckoning (aka. Odometry)	-->
<!--		<arg name="/localization" value="true"/>
		<arg name="/localization/deadreckoning" value="true"/>
LP removing for now
-->
	    <!-- Lane Following stack -->
	    <arg name="lane_following" value="true"/>
	    <arg name="/lane_following/line_detection" value="true"/>
	    <arg name="line_detector_param_file_name" value="default" />
	    <arg name="/lane_following/ground_projection" value="true"/>
	    <arg name="/lane_following/lane_filter" value="true"/>
	    <arg name="/lane_following/lane_controller" value="false"/>
	    <arg name="LED" value="false"/>
	    <arg name="/LED/emitter" value="false"/>

  	</include>

        <group ns="$(arg veh)">
	    <node  pkg="$(arg pkg_name)" type="$(arg node_name).py" name="$(arg node_name)" output="screen">
	        <!-- <rosparam command="load" file="$(find fpd_control)/config/$(arg node_name)/$(arg param_file_name).yaml"/> -->
	    </node>
	</group>

</launch>

